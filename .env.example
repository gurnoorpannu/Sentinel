NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgresql://sentinel:sentinel@localhost:5432/sentinel
DATABASE_POOL_MAX=10
API_HOST=0.0.0.0
API_PORT=4000
API_REQUEST_TIMEOUT_MS=30000
API_KEEP_ALIVE_TIMEOUT_MS=72000
SHUTDOWN_GRACE_PERIOD_MS=30000
WORKER_ID=worker-local
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_MS=1000
LEASE_DURATION_MS=30000
HEARTBEAT_INTERVAL_MS=10000
RETRY_BASE_DELAY_MS=1000
RETRY_MAX_DELAY_MS=30000
RETRY_JITTER_RATIO=0.2
CHAOS_MODE_ENABLED=false
METRICS_TOKEN=replace-with-at-least-16-characters
OPERATOR_TOKEN=replace-with-at-least-32-random-characters
NEXT_PUBLIC_API_URL=http://localhost:4000
SENTINEL_API_URL=http://localhost:4000
